{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true, "noEmit": true,
    "isolatedModules": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "server", "scripts", "vite.config.ts"]
}
